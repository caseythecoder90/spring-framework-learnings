---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const { title, description = 'How Spring actually behaves, with a test pinning every claim.', current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: `${base}/`, label: 'Start here', key: 'start' },
  { href: `${base}/tracks`, label: 'All topics', key: 'tracks' },
  { href: `${base}/notes/reading-the-source`, label: 'Reading the source', key: 'reading-the-source' },
  { href: `${base}/paths`, label: 'Code paths', key: 'paths' },
  { href: 'https://github.com/caseythecoder90/spring-framework-learnings', label: 'GitHub', key: 'github' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {
        /* private mode */
      }
    </script>
  </head>
  <body>
    <header class="top">
      <div class="top-inner">
        <a class="brand" href={`${base}/`}>spring-framework-learnings</a>
        <nav>
          {
            nav.map((item) => (
              <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <button class="ghost" id="theme" type="button">Dark</button>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="foot">
      Every claim here is pinned by a test in the
      <a href="https://github.com/caseythecoder90/spring-framework-learnings">repo</a>.
    </footer>

    <script is:inline>
      (function () {
        const root = document.documentElement;
        const btn = document.getElementById('theme');
        if (!btn) return;
        const current = () =>
          root.getAttribute('data-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const paint = () => (btn.textContent = current() === 'dark' ? 'Light' : 'Dark');
        paint();
        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {
            /* private mode */
          }
          paint();
        });
      })();
    </script>
  </body>
</html>
