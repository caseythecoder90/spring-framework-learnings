<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.caseythecoder.spring</groupId>
  <artifactId>spring-framework-learnings</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>spring-framework-learnings</name>
  <description>Executable notes on how Spring Framework features actually work under the hood</description>

  <modules>
    <module>labs/lab-support</module>
    <module>labs/lab-scheduling</module>
    <module>labs/lab-events</module>
    <module>labs/lab-annotations</module>
    <module>labs/lab-proxies</module>
    <module>labs/lab-lifecycle</module>
    <module>labs/lab-async</module>
    <module>labs/lab-codepaths</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Bumped by tools/fetch-spring-sources.sh; keep in sync with the Boot BOM above. -->
    <spring-framework-source.version>7.0.9</spring-framework-source.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.caseythecoder.spring</groupId>
        <artifactId>lab-support</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!--
          Declared here purely so that `-pl labs/lab-x -am spring-boot:run` does not fail on the
          aggregator and on lab-support, neither of which has a main class. The runnable labs
          switch it back on.
        -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Timing-sensitive labs: keep them off each other's CPU. -->
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
